//@version=5
// =====================================================================
// XAUUSD Trendline Break Signal (own implementation, stop-and-reverse)
// =====================================================================
// This is an independent, self-contained recreation of the classic
// "pivot-based dynamic trendline break" concept (the same idea behind
// oscillators like LuxAlgo's Trendlines-with-Breaks) - NOT a copy of
// any third-party proprietary script. It is built this way so it can
// be fully automated end-to-end (Pine here + a matching MT5 EA),
// instead of depending on whether a closed-source indicator exposes
// alerts or a linkable plot() source.
//
// Logic (v2 - "reaction at the line"):
//   - Detect confirmed pivot highs/lows (lookback bars each side) and
//     project a resistance line through the last 2 pivot highs and a
//     support line through the last 2 pivot lows.
//   - Every time price reacts to one of these lines, there are exactly
//     two possible outcomes, and the script trades whichever one
//     actually happens:
//       1) BREAKOUT (continuation): a closed bar clears the line by
//          the confirmation buffer -> trade in the breakout direction.
//       2) BOUNCE (reversal): price touches the line (within an
//          ATR-based tolerance) but does NOT clear it, and a
//          candlestick reversal pattern (engulfing and/or pin bar)
//          confirms the rejection -> trade in the opposite direction.
//   - Whichever fires first "reacts" that line (resReacted/supReacted)
//     so it does not fire twice; the line resets and can react again
//     only once a fresh pivot re-projects it.
//   - Each entry carries an ATR-based SL and an R:R-based TP, so the
//     position also closes automatically "when profit target is hit",
//     not only on the opposite signal. An opposite confirmed signal
//     still closes/reverses the current position (stop & reverse).
//   - An automatic "R-multiple panel" is drawn on every entry (entry,
//     SL and 1R..NR levels + profit/loss shading), the same way you'd
//     mark it manually with a Fibonacci/measurement tool.
//
// Educational / research template. Backtest and forward-test on demo
// before using with real capital. No indicator or EA guarantees
// profitability.
// =====================================================================
strategy("XAUUSD Trendline Break (Stop & Reverse)", shorttitle="XAU TL Break",
         overlay=true, initial_capital=10000,
         default_qty_type=strategy.percent_of_equity, default_qty_value=100,
         pyramiding=0, calc_on_every_tick=false,
         max_lines_count=300, max_labels_count=300, max_boxes_count=300)

// ===================== INPUTS =======================================
pivotLen   = input.int(5, "Pivot lookback (bars each side)", minval=2, group="Trendline")
showLines  = input.bool(true, "Draw trendlines on chart", group="Trendline")

entryMode  = input.string("Both", "Entry mode", options=["Breakout Only", "Bounce Only", "Both"], group="Entry Logic",
     tooltip="Breakout Only = trade continuation when the line is cleared. Bounce Only = trade reversal when the line is respected with a candle pattern. Both = trade whichever outcome actually happens.")
breakoutBuffer = input.float(0.20, "Breakout confirmation buffer ($)", step=0.05, group="Entry Logic")
touchATRMult   = input.float(0.35, "Touch tolerance for bounce (x ATR)", step=0.05, group="Entry Logic",
     tooltip="How close price needs to get to the line (in ATR) to count as a 'touch' eligible for a bounce trade.")
useEngulfing   = input.bool(true, "Confirm bounce with Engulfing pattern", group="Entry Logic")
usePinBar      = input.bool(true, "Confirm bounce with Pin Bar (hammer / shooting star)", group="Entry Logic")

slATRMult  = input.float(1.5, "SL = ATR x", group="Risk / SL / TP")
rrMult     = input.float(3.0, "Risk:Reward multiple (TP = SL distance x this)", group="Risk / SL / TP")
atrLen     = input.int(14, "ATR period", group="Risk / SL / TP")

showRPanel     = input.bool(true, "Draw automatic R-multiple panel on entry", group="Visuals")
maxRLevels     = input.int(5, "Max R levels to draw", minval=1, maxval=10, group="Visuals")
panelBarsRight = input.int(20, "Panel width (bars to the right)", minval=5, group="Visuals")
showLivePanel  = input.bool(true, "Show live scanning panel", group="Visuals")
panelSize      = input.string("normal", "Panel text size", options=["tiny", "small", "normal"], group="Visuals")
tSize = panelSize == "tiny" ? size.tiny : panelSize == "small" ? size.small : size.normal

// ===================== PIVOTS & TRENDLINES ============================
atrVal = ta.atr(atrLen)

ph = ta.pivothigh(pivotLen, pivotLen)
pl = ta.pivotlow(pivotLen, pivotLen)

var float ph1 = na
var float ph2 = na
var int   phBar1 = na
var int   phBar2 = na
var float pl1 = na
var float pl2 = na
var int   plBar1 = na
var int   plBar2 = na

var bool resReacted = false
var bool supReacted = false

// last trade info, kept for the live status panel
var float lastEntry     = na
var float lastSL        = na
var float lastTP        = na
var bool  lastWasLong   = na
var string lastReason   = "n/a"
var int   lastSignalBar = na

if not na(ph)
    ph2 := ph1
    phBar2 := phBar1
    ph1 := ph
    phBar1 := bar_index - pivotLen
    resReacted := false

if not na(pl)
    pl2 := pl1
    plBar2 := plBar1
    pl1 := pl
    plBar1 := bar_index - pivotLen
    supReacted := false

resSlope = (not na(ph1) and not na(ph2) and phBar1 != phBar2) ? (ph1 - ph2) / (phBar1 - phBar2) : na
supSlope = (not na(pl1) and not na(pl2) and plBar1 != plBar2) ? (pl1 - pl2) / (plBar1 - plBar2) : na

resNow = not na(resSlope) ? ph1 + resSlope * (bar_index - phBar1) : na
supNow = not na(supSlope) ? pl1 + supSlope * (bar_index - plBar1) : na

// ===================== CANDLESTICK REVERSAL PATTERNS ===================
body       = math.abs(close - open)
upperWick  = high - math.max(close, open)
lowerWick  = math.min(close, open) - low

bullishEngulfing = close[1] < open[1] and close > open and close >= open[1] and open <= close[1]
bearishEngulfing = close[1] > open[1] and close < open and open >= close[1] and close <= open[1]

isHammer       = body > 0 and lowerWick >= body * 2.0 and upperWick <= body * 0.6
isShootingStar = body > 0 and upperWick >= body * 2.0 and lowerWick <= body * 0.6

bullishPattern = (useEngulfing and bullishEngulfing) or (usePinBar and isHammer)
bearishPattern = (useEngulfing and bearishEngulfing) or (usePinBar and isShootingStar)

// ===================== TOUCH DETECTION ==================================
touchTol = atrVal * touchATRMult
touchingSupport    = not na(supNow) and low  <= supNow + touchTol and close > supNow - touchTol
touchingResistance = not na(resNow) and high >= resNow - touchTol and close < resNow + touchTol

// ===================== REACTION AT THE LINE (breakout vs bounce) =======
allowBreakout = entryMode != "Bounce Only"
allowBounce   = entryMode != "Breakout Only"

breakoutLong  = allowBreakout and not na(resNow) and not resReacted and close > resNow + breakoutBuffer
bounceShort   = not breakoutLong and allowBounce and touchingResistance and not resReacted and bearishPattern

breakoutShort = allowBreakout and not na(supNow) and not supReacted and close < supNow - breakoutBuffer
bounceLong    = not breakoutShort and allowBounce and touchingSupport and not supReacted and bullishPattern

if breakoutLong or bounceShort
    resReacted := true
if breakoutShort or bounceLong
    supReacted := true

finalLong  = breakoutLong or bounceLong
finalShort = breakoutShort or bounceShort

reasonLong  = breakoutLong ? "Breakout @ Resistance" : "Bounce @ Support"
reasonShort = breakoutShort ? "Breakout @ Support" : "Bounce @ Resistance"

// ===================== VISUALS: TRENDLINES ==============================
var line resLine = na
var line supLine = na

if showLines and not na(resSlope)
    line.delete(resLine)
    resLine := line.new(phBar2, ph2, bar_index, resNow, color=color.new(color.red, 20), width=1, extend=extend.right)
if showLines and not na(supSlope)
    line.delete(supLine)
    supLine := line.new(plBar2, pl2, bar_index, supNow, color=color.new(color.lime, 20), width=1, extend=extend.right)

plotshape(breakoutLong,  title="Breakout Long (Resistance)",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 0),   size=size.small)
plotshape(bounceLong,    title="Bounce Long (Support)",       style=shape.circle,       location=location.belowbar, color=color.new(color.aqua, 0),   size=size.small)
plotshape(breakoutShort, title="Breakout Short (Support)",    style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),    size=size.small)
plotshape(bounceShort,   title="Bounce Short (Resistance)",   style=shape.circle,       location=location.abovebar, color=color.new(color.orange, 0), size=size.small)

// ===================== R-MULTIPLE PANEL (auto Fibonacci-like levels) ===
var line[]  panelLines  = array.new<line>()
var label[] panelLabels = array.new<label>()
var box[]   panelBoxes  = array.new<box>()

clearPanel() =>
    if array.size(panelLines) > 0
        for i = 0 to array.size(panelLines) - 1
            line.delete(array.get(panelLines, i))
        array.clear(panelLines)
    if array.size(panelLabels) > 0
        for i = 0 to array.size(panelLabels) - 1
            label.delete(array.get(panelLabels, i))
        array.clear(panelLabels)
    if array.size(panelBoxes) > 0
        for i = 0 to array.size(panelBoxes) - 1
            box.delete(array.get(panelBoxes, i))
        array.clear(panelBoxes)

drawRPanel(isLong, entryPrice, slPrice, slDist) =>
    clearPanel()
    rightBar = bar_index + panelBarsRight

    array.push(panelLines, line.new(bar_index, entryPrice, rightBar, entryPrice, color=color.new(color.gray, 30), style=line.style_dashed))
    array.push(panelLabels, label.new(rightBar, entryPrice, "0  " + str.tostring(entryPrice, format.mintick), style=label.style_label_left, size=size.small, color=color.new(color.gray, 70), textcolor=color.white))

    array.push(panelLines, line.new(bar_index, slPrice, rightBar, slPrice, color=color.new(color.red, 10), style=line.style_dashed, width=2))
    array.push(panelLabels, label.new(rightBar, slPrice, "SL  " + str.tostring(slPrice, format.mintick), style=label.style_label_left, size=size.small, color=color.new(color.red, 50), textcolor=color.white))

    tpFinal = isLong ? entryPrice + slDist * rrMult : entryPrice - slDist * rrMult
    array.push(panelBoxes, box.new(bar_index, entryPrice, rightBar, tpFinal, bgcolor=color.new(color.green, 88), border_color=color.new(color.green, 60)))
    array.push(panelBoxes, box.new(bar_index, entryPrice, rightBar, slPrice, bgcolor=color.new(color.red, 88), border_color=color.new(color.red, 60)))

    for i = 1 to maxRLevels
        levelPrice = isLong ? entryPrice + slDist * i : entryPrice - slDist * i
        isTarget   = i <= int(math.round(rrMult))
        lvlColor   = isTarget ? color.new(color.green, 20) : color.new(color.teal, 40)
        array.push(panelLines, line.new(bar_index, levelPrice, rightBar, levelPrice, color=lvlColor, style=line.style_dotted))
        array.push(panelLabels, label.new(rightBar, levelPrice, str.tostring(i) + "  " + str.tostring(levelPrice, format.mintick), style=label.style_label_left, size=size.small, color=isTarget ? color.new(color.green, 50) : color.new(color.teal, 60), textcolor=color.white))

// ===================== TRADE EXECUTION + LABELS =========================
drawTrade(isLong, reason) =>
    strategy.close(isLong ? "Short" : "Long")

    slDist     = atrVal * slATRMult
    entryPrice = close
    slPrice    = isLong ? entryPrice - slDist : entryPrice + slDist
    tpPrice    = isLong ? entryPrice + slDist * rrMult : entryPrice - slDist * rrMult
    idPrefix   = isLong ? "Long" : "Short"

    strategy.entry(idPrefix, isLong ? strategy.long : strategy.short)
    strategy.exit(idPrefix + "Exit", idPrefix, stop=slPrice, limit=tpPrice)

    // Compact on-chart mark (direction + entry price only) - full detail lives in the live panel below,
    // so the chart doesn't get buried in text boxes when several trades fire close together.
    label.new(bar_index, isLong ? low - atrVal * 0.3 : high + atrVal * 0.3,
         (isLong ? "▲ " : "▼ ") + str.tostring(entryPrice, format.mintick),
         style = isLong ? label.style_label_up : label.style_label_down,
         color = isLong ? color.new(color.green, 0) : color.new(color.red, 0),
         textcolor = color.white, size = size.tiny)

    if showRPanel
        drawRPanel(isLong, entryPrice, slPrice, slDist)

    alertMsg = '{"symbol":"' + syminfo.ticker + '","side":"' + (isLong ? "BUY" : "SELL") +
         '","reason":"' + reason + '","entry":' + str.tostring(entryPrice) +
         ',"sl":' + str.tostring(slPrice) + ',"tp":' + str.tostring(tpPrice) + '}'
    alert(alertMsg, alert.freq_once_per_bar)

    [entryPrice, slPrice, tpPrice]

// Global vars can only be reassigned at the script's top level, not from
// inside a function - so drawTrade() returns the trade's numbers here and
// the assignment to lastEntry/lastSL/... happens in this outer scope.
if finalLong
    [e, s, t] = drawTrade(true, reasonLong)
    lastEntry := e
    lastSL := s
    lastTP := t
    lastWasLong := true
    lastReason := reasonLong
    lastSignalBar := bar_index

if finalShort
    [e, s, t] = drawTrade(false, reasonShort)
    lastEntry := e
    lastSL := s
    lastTP := t
    lastWasLong := false
    lastReason := reasonShort
    lastSignalBar := bar_index

// ===================== ALERTS (for webhook -> broker bridge) ===========
alertcondition(finalLong,      title="XAU TL Break BUY (any)",       message="XAUUSD trendline BUY signal")
alertcondition(finalShort,     title="XAU TL Break SELL (any)",      message="XAUUSD trendline SELL signal")
alertcondition(breakoutLong,   title="XAU TL Break BUY (Breakout)",  message="XAUUSD breakout BUY - resistance cleared")
alertcondition(bounceLong,     title="XAU TL Break BUY (Bounce)",    message="XAUUSD bounce BUY - support respected")
alertcondition(breakoutShort,  title="XAU TL Break SELL (Breakout)", message="XAUUSD breakout SELL - support cleared")
alertcondition(bounceShort,    title="XAU TL Break SELL (Bounce)",   message="XAUUSD bounce SELL - resistance respected")

// ===================== LIVE SCANNING PANEL ================================
distToRes    = na(resNow) ? na : resNow - close
distToSup    = na(supNow) ? na : close - supNow
distToResATR = (na(distToRes) or atrVal <= 0) ? na : distToRes / atrVal
distToSupATR = (na(distToSup) or atrVal <= 0) ? na : distToSup / atrVal

posSize    = strategy.position_size
inPosition = posSize != 0
isLongPos  = posSize > 0

riskDist = (na(lastEntry) or na(lastSL)) ? na : math.abs(lastEntry - lastSL)
liveR    = (not inPosition or na(riskDist) or riskDist == 0) ? na :
     (isLongPos ? (close - lastEntry) / riskDist : (lastEntry - close) / riskDist)

statusText  = inPosition ? (isLongPos ? "EN LONG" : "EN SHORT") :
     touchingResistance ? "Tocando resistencia..." :
     touchingSupport ? "Tocando soporte..." :
     "Escaneando mercado..."
statusColor = inPosition ? (isLongPos ? color.new(color.green, 10) : color.new(color.red, 10)) : color.new(color.gray, 20)

barsAgo = na(lastSignalBar) ? na : bar_index - lastSignalBar

var table livePanel = table.new(position.top_right, 2, 9, border_width=1)
if showLivePanel and barstate.islast
    table.cell(livePanel, 0, 0, "Estado", text_color=color.white, bgcolor=color.gray, text_size=tSize)
    table.cell(livePanel, 1, 0, statusText, text_color=color.white, bgcolor=statusColor, text_size=tSize)

    table.cell(livePanel, 0, 1, "Precio", text_color=color.white, bgcolor=color.gray, text_size=tSize)
    table.cell(livePanel, 1, 1, str.tostring(close, format.mintick), text_color=color.white, bgcolor=color.navy, text_size=tSize)

    table.cell(livePanel, 0, 2, "Resistencia", text_color=color.white, bgcolor=color.gray, text_size=tSize)
    table.cell(livePanel, 1, 2, na(resNow) ? "n/a" : str.tostring(resNow, format.mintick) + "  (" + str.tostring(distToResATR, "#.##") + " ATR)", text_color=color.white, bgcolor=color.maroon, text_size=tSize)

    table.cell(livePanel, 0, 3, "Soporte", text_color=color.white, bgcolor=color.gray, text_size=tSize)
    table.cell(livePanel, 1, 3, na(supNow) ? "n/a" : str.tostring(supNow, format.mintick) + "  (" + str.tostring(distToSupATR, "#.##") + " ATR)", text_color=color.white, bgcolor=color.olive, text_size=tSize)

    table.cell(livePanel, 0, 4, "Posición", text_color=color.white, bgcolor=color.gray, text_size=tSize)
    table.cell(livePanel, 1, 4, inPosition ? str.tostring(math.abs(posSize), "#.##") + " lotes @ " + str.tostring(lastEntry, format.mintick) : "Sin posición", text_color=color.white, bgcolor=color.navy, text_size=tSize)

    table.cell(livePanel, 0, 5, "SL / TP", text_color=color.white, bgcolor=color.gray, text_size=tSize)
    table.cell(livePanel, 1, 5, inPosition ? str.tostring(lastSL, format.mintick) + " / " + str.tostring(lastTP, format.mintick) : "n/a", text_color=color.white, bgcolor=color.navy, text_size=tSize)

    table.cell(livePanel, 0, 6, "R actual", text_color=color.white, bgcolor=color.gray, text_size=tSize)
    table.cell(livePanel, 1, 6, na(liveR) ? "n/a" : str.tostring(liveR, "#.##") + "R  (objetivo 1:" + str.tostring(rrMult, "#.##") + ")", text_color=color.white, bgcolor=liveR > 0 ? color.new(color.green, 20) : color.new(color.red, 20), text_size=tSize)

    table.cell(livePanel, 0, 7, "Última señal", text_color=color.white, bgcolor=color.gray, text_size=tSize)
    table.cell(livePanel, 1, 7, lastReason + (na(barsAgo) ? "" : " (" + str.tostring(barsAgo) + " velas atrás)"), text_color=color.white, bgcolor=color.navy, text_size=tSize)

    table.cell(livePanel, 0, 8, "Modo / Patrones", text_color=color.white, bgcolor=color.gray, text_size=tSize)
    table.cell(livePanel, 1, 8, entryMode + " · " + (useEngulfing ? "Engulfing " : "") + (usePinBar ? "PinBar" : ""), text_color=color.white, bgcolor=color.navy, text_size=tSize)
